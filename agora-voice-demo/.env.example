# ─────────────────────────────────────────────────────────────────────────────
# Environment template.  Copy to .env.local and fill in real values:
#     cp .env.example .env.local
# .env.local is gitignored and never committed.  Every value below is a
# placeholder — replace each `your_*`.  Variable names match exactly what the
# code reads via process.env (do not rename them).
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# GROUP A — Storybook tutor  (/tutor — the main app)
# The minimum to generate + narrate an interruptible voice lesson.
# ═════════════════════════════════════════════════════════════════════════════

# REQUIRED — Agora app credentials (https://console.agora.io).
# The app mints the browser's RTC+RTM join token from these and starts the voice
# agent. Both are requireEnv'd — the app throws on startup if unset.
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id
NEXT_AGORA_APP_CERTIFICATE=your_agora_app_certificate

# REQUIRED — Google Gemini API key (https://aistudio.google.com/apikey).
# Drives ALL lesson generation: scene composition, illustration + video, the
# narration script, and the barge-in resume planner.
GOOGLE_API_KEY=your_google_api_key

# The uid the Agora cloud agent joins as. Must match the agent uid used server
# side. Default in code is "123456" if unset; set it to be explicit.
NEXT_PUBLIC_AGENT_UID=123456

# OPTIONAL — Gemini model overrides (sensible defaults in code).
# GEMINI_MODEL=gemini-3.1-flash-lite          # resume planner / general
# GEMINI_SCRIPT_MODEL=gemini-3.1-flash-lite   # narration script generation

# OPTIONAL — per-session debug log (lib/orchestrator/session-logger.ts).
# On by default; set to 0 to disable. TUTOR_LOG_DIR overrides the folder
# (default logs/sessions, gitignored). On Vercel only the console sink runs.
# TUTOR_SESSION_LOG=1
# TUTOR_LOG_DIR=logs/sessions


# ═════════════════════════════════════════════════════════════════════════════
# GROUP B — Legacy conversation quickstart  (BYOK for app/api/invite-agent)
# Only needed if you switch the original Agora chat demo off Agora-managed
# inference to bring-your-own-keys. NOT needed to run /tutor. Each is requireEnv'd
# ONLY inside its (commented-out) BYOK block in invite-agent/route.ts.
# ═════════════════════════════════════════════════════════════════════════════

# OpenAI-compatible LLM
# NEXT_LLM_URL=https://api.openai.com/v1/chat/completions
# NEXT_LLM_API_KEY=your_llm_api_key

# Deepgram STT
# NEXT_DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs TTS
# NEXT_ELEVENLABS_API_KEY=your_elevenlabs_api_key
# NEXT_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Optional agent greeting override
# NEXT_AGENT_GREETING=Hello! How can I help you today?


# ═════════════════════════════════════════════════════════════════════════════
# GROUP C — Offline eval / benchmark only  (scripts/qa-bench/*, e2e scripts)
# Not needed to run the app. Only for the qa-resume benchmark + grader and the
# scripted e2e/interrupt harnesses.
# ═════════════════════════════════════════════════════════════════════════════

# LLM-judge model for the grader (defaults to a Gemini flash model via GOOGLE_API_KEY).
# JUDGE_MODEL=gemini-3.5-flash

# Alternate persona/judge providers for cross-model bench runs.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_DIRECT_API_KEY=your_openai_api_key   # note: this repo's OPENAI slot is Z.AI
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com

# Scripted-harness runtime args (usually passed inline, not via .env):
# BASE_URL / E2E_BASE_URL / BARGE_BASE_URL  — target dev server URL
# TOPIC / INTERRUPT / INTERRUPT_AFTER        — e2e scenario knobs
# BARGE_LEAD_MS / BARGE_OBSERVE_MS / BARGE_IN_TUNING — audio barge-in timing
