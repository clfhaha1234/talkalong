# ─── Agora ────────────────────────────────────────────────────────────────────
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# UID the AI agent joins the channel with.
# - Must match the agentUid set in app/api/invite-agent/route.ts.
# - (Optional override) Defaults: to 123456 (via lib/agora.ts)
NEXT_PUBLIC_AGENT_UID=123456

# Optional BYOK examples:
# - Uncomment the matching blocks in app/api/invite-agent/route.ts if you want to bring
# - your own vendor credentials instead of using the Agora-managed defaults.
# NEXT_DEEPGRAM_API_KEY=
# NEXT_LLM_URL=https://api.openai.com/v1/chat/completions
# NEXT_LLM_API_KEY=
# NEXT_ELEVENLABS_API_KEY=
# NEXT_ELEVENLABS_VOICE_ID=

# ─── Agent behavior ───────────────────────────────────────────────────────────
# Optional opening line override
# NEXT_AGENT_GREETING=Hi there! I'm Ada, your virtual assistant from Agora. How can I help?

# ─── Storybook tutor (lesson generation + resume planner) ─────────────────────
# Required for lesson script generation, Gemini-powered scene illustration, and
# the resume-planner LLM call. Get one from https://aistudio.google.com/
GOOGLE_API_KEY=

# Optional override for the Gemini model used by the orchestrator + qa-bench.
# Default = gemini-3.1-flash-lite (fast TTFT, minimal reasoning effort baked in).
# GEMINI_MODEL=gemini-3.1-flash-lite

# ─── QA-resume benchmark only (scripts/qa-bench/) ─────────────────────────────
# Optional. Used when you pass --qa-model anthropic:claude-haiku-4-5-... to the
# bench. Not needed for the running app. Get one from https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Optional. Used when you pass --qa-model openai:gpt-5-mini etc. to the bench.
# NOTE: this is a DIRECT OpenAI key, not the Agora-managed reseller.
# OPENAI_DIRECT_API_KEY=
